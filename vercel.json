{
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/commissions-digest",
      "schedule": "0 11 * * 5"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "presentation.cardinalroster.com"
        }
      ],
      "destination": "/popup.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "presentation.cardinalrenovations.com"
        }
      ],
      "destination": "/popup.html"
    }
  ]
}
