__pycache__/
*.pyc
node_modules/

# Secrets. spark/.env holds the Supabase SERVICE ROLE key, which bypasses
# every RLS policy in the database — it lives on the Spark box and must never
# reach a commit. VISUALIZER_SETUP.md tells the reader this file is ignored;
# these lines are what make that true.
.env
.env.*
!.env.example
spark/.env

# The Exterior Visualizer is plain static HTML (807) — no build step, no
# dependencies. These stay as a guard in case anyone reintroduces tooling
# there; the Next.js app they were written for was dropped before it shipped.
visualizer/.next/
visualizer/out/
visualizer/node_modules/

# The Chromium gates (gate_*.mjs, render_*.js) import 'playwright', and ESM
# ignores NODE_PATH. A symlink here resolves it:
#     ln -sfn /opt/node22/lib/node_modules .claude/skills/cardinal-build/scripts/node_modules
# It is a local convenience, never a dependency of the app. Committed once by
# accident at 1063 and removed in the same session.
#
# Two gates need a package that is NOT in the global install, so point the
# symlink at a directory you own and add them there:
#     npm install jsdom axe-core
# jsdom runs the harness_*.js family; axe-core runs gate_a11y.mjs. Both refuse
# to run with a usage error when their package is missing — never a quiet pass.
.claude/skills/cardinal-build/scripts/node_modules

# A gate's negative-control artifact — a local copy of the previous build that
# gate_*.mjs / render_*.mjs / sentinel.js are pointed at (every one takes a
# path argument for exactly this). Session-local, ~5 MB, never committed.
# ⚠ Do not delete it while a sentinel sweep is still running — the 1192 log
# records the 1191 sweep dying on exactly that (ENOENT mid-run).
.claude/skills/cardinal-build/scripts/prev_control.html
